# Copy this file to .env and insert your actual key.

# Required. Powers both sentiment analysis and reply generation.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Optional. Overrides the Groq model if the default is ever retired
# (llama-3.1-8b-instant was, which is why this exists).
# List what your account can use: Groq().models.list()
# GROQ_MODEL=openai/gpt-oss-20b
